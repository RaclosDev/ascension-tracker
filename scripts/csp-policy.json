      "https://images.openfoodfacts.org",
      "https://raw.githubusercontent.com"
    ],
    "connect-src": [
      "'self'",
      "https://ascension-backend-7dd8e6190a75.herokuapp.com",
      "https://ascension.raclos.es",
      "https://accounts.google.com"
    ],
    "frame-src": ["https://accounts.google.com"],
