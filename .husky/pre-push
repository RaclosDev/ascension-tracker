# 1. VERIFICACIÓN DEL BACKEND
echo "⚙️  Verificando Backend (Compilación y Tests)..."
cd backend && ./mvnw test-compile test || {
  echo "❌ ERROR CRÍTICO: Falló la compilación o los tests del backend."
  echo "💡 Solución: Revisa los errores de Maven arriba, arréglalos, haz un commit y vuelve a intentar el push."
  exit 1
}
cd ..
echo "✅ Backend verificado."

# 2. VERIFICACIÓN DEL FRONTEND
echo "🎨 Verificando Frontend (Lint, Tipos, Tests y Build)..."
cd frontend && npm run lint && npm run typecheck && npm run test -- --run && npm run build || {
  echo "❌ ERROR CRÍTICO: El Frontend no superó las verificaciones de calidad."
  echo "💡 Solución: Ejecuta 'npm run lint', 'npm run typecheck' y 'npm test' localmente."
  exit 1
}
cd ..
echo "✅ Frontend verificado."

echo "========================================================="
echo "✅ AUDITORÍA SUPERADA. Subiendo código a GitHub..."
echo "========================================================="
