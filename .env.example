# ==========================================
# Ascension Tracker - Environment Variables
# ==========================================

# --- Database ---
# Credentials for the PostgreSQL database (used by docker-compose)
POSTGRES_USER=ascension
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ascension_db
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Backend Secrets ---
# JWT_SECRET must be exactly or at least 32 characters long for HS256!
JWT_SECRET=super_secret_key_needs_32_chars_min
# Google OAuth Client ID for validating Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# FatSecret API Credentials (https://platform.fatsecret.com/)
FATSECRET_CLIENT_ID=your_fatsecret_client_id
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret
# VAPID Keys for Web Push Notifications (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com
# Google AI Studio Key
GEMINI_API_KEY=your_gemini_api_key
# CORS Allowed origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend variables ---
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
