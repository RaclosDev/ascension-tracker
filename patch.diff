From c7b8cdfa286ee774c2a3ca246d4ceb0156afbd25 Mon Sep 17 00:00:00 2001
From: Security Hardening <dev@example.com>
Date: Thu, 8 Oct 2026 23:29:41 +0000
Subject: [PATCH 3/4] fix(security): cabeceras de seguridad que si llegan en
 nginx + CSP report-only

Los location con add_header propio (/, sw/manifest, estaticos) no heredaban las
cabeceras del server, asi que nosniff/X-Frame-Options/Referrer-Policy no se enviaban.
Se centralizan en security-headers.conf, se incluyen en cada location y se anaden
Permissions-Policy y una CSP en modo report-only.
---
 frontend/Dockerfile            |  1 +
 frontend/nginx.conf            |  9 +++++----
 frontend/security-headers.conf | 21 +++++++++++++++++++++
 3 files changed, 27 insertions(+), 4 deletions(-)
 create mode 100644 frontend/security-headers.conf

diff --git a/frontend/Dockerfile b/frontend/Dockerfile
index 83563b2..e5e6d7b 100644
--- a/frontend/Dockerfile
+++ b/frontend/Dockerfile
@@ -12,5 +12,6 @@ RUN npm run build
 FROM nginx:alpine
 COPY --from=build /app/dist /usr/share/nginx/html
 COPY nginx.conf /etc/nginx/conf.d/default.conf
+COPY security-headers.conf /etc/nginx/security-headers.conf
 EXPOSE 80
 CMD ["nginx", "-g", "daemon off;"]
diff --git a/frontend/nginx.conf b/frontend/nginx.conf
index 328b0f3..e249c03 100644
--- a/frontend/nginx.conf
+++ b/frontend/nginx.conf
@@ -10,18 +10,18 @@ server {
     root /usr/share/nginx/html;
     index index.html;
 
-    # Security headers for all responses
-    add_header X-Content-Type-Options "nosniff" always;
-    add_header X-Frame-Options "DENY" always;
-    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+    # Las cabeceras de seguridad se incluyen en cada location estatica (ver
+    # security-headers.conf): un location con su propio add_header no hereda las del server.
 
     location / {
         try_files $uri $uri/ /index.html;
+        include /etc/nginx/security-headers.conf;
         add_header Cache-Control "no-cache, no-store, must-revalidate";
     }
 
     # Don't cache Service Worker or Manifest
     location ~* (sw\.js|sw\.mjs|manifest\.webmanifest|manifest\.json)$ {
+        include /etc/nginx/security-headers.conf;
         add_header Cache-Control "no-cache, no-store, must-revalidate";
     }
 
@@ -36,6 +36,7 @@ server {
     # Cache static assets for 1 year
     location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
         expires 1y;
+        include /etc/nginx/security-headers.conf;
         add_header Cache-Control "public, immutable";
     }
 }
diff --git a/frontend/security-headers.conf b/frontend/security-headers.conf
new file mode 100644
index 0000000..c3eefd0
--- /dev/null
+++ b/frontend/security-headers.conf
@@ -0,0 +1,21 @@
+# Cabeceras de seguridad para las respuestas ESTATICAS del frontend.
+#
+# IMPORTANTE: en nginx, si un bloque `location` declara su propio add_header,
+# NO hereda los add_header del nivel `server`. Por eso este fichero se incluye
+# explicitamente dentro de cada location estatica (ver nginx.conf).
+# Las respuestas de /api/ las firma Spring Security, no se tocan aqui.
+
+add_header X-Content-Type-Options "nosniff" always;
+add_header X-Frame-Options "DENY" always;
+add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+# La app usa camara (escaner de codigo de barras) y microfono (voz a texto).
+add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()" always;
+
+# HSTS: activalo cuando estes seguro de que SIEMPRE se sirve por HTTPS
+# (el navegador lo recordara durante el max-age).
+# add_header Strict-Transport-Security "max-age=31536000" always;
+
+# CSP en modo REPORT-ONLY: no bloquea nada, solo avisa en la consola del navegador.
+# Navega por toda la app (login con Google, escaner, voz, graficas, push) y,
+# cuando no haya avisos, cambia el nombre de la cabecera a Content-Security-Policy.
+add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
-- 
