{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "prepare": "husky",
    "sync:csp": "node scripts/generate-csp.js",
    "check:csp": "node scripts/generate-csp.js --check"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm --prefix frontend exec -- prettier --write",
      "node scripts/lint-staged-frontend.mjs"
    ]
  }
}
