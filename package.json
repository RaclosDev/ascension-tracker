{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm --prefix frontend exec -- eslint --fix --config frontend/eslint.config.js",
      "npm --prefix frontend exec -- prettier --write"
    ]
  }
}
